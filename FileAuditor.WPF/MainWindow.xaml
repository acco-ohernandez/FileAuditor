<Window x:Class="FileAuditor.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileAuditor.WPF"
        xmlns:converters="clr-namespace:FileAuditor.WPF.Converters"
        xmlns:enums="clr-namespace:FileAuditor.Core.Enums;assembly=FileAuditor.Core"
        mc:Ignorable="d"
        Title="File Auditor" Height="800" Width="1400"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen">
   
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:ScanStatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:BytesToSizeConverter x:Key="BytesToSizeConverter"/>
        <converters:DateModeToVisibilityConverter x:Key="DateModeToVisConverter"/>


        <!-- Styles -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>

        <!-- Expander Style (replaces GroupBoxStyle for Expanders) -->
        <Style x:Key="ExpanderStyle" TargetType="Expander">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Import Paths from CSV" Command="{Binding ImportFromCsvCommand}"/>
                <MenuItem Header="_Export Results to CSV" Command="{Binding ExportToCsvCommand}"/>
                <MenuItem Header="Export Results to _JSON" Command="{Binding ExportToJsonCommand}"/>
                <!--OpenLogsFolder_Click-->
                <MenuItem Header="Open _Logs Folder" Click="OpenLogsFolder_Click"/>
                <Separator/>
                <MenuItem Header="Clear _All" Click="ClearAll_Click" ToolTip="Reset all tabs to default settings">
                    <MenuItem.Icon>
                        <TextBlock Text="🗑️" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Configuration">
                <MenuItem Header="_Save Current Configuration" Command="{Binding SaveConfigurationCommand}"/>
                <MenuItem Header="_Load Configuration" Command="{Binding LoadConfigurationCommand}"/>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="Help Contents" Click="HelpContents_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="📖" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="File Counter" Click="ScanHelp_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🔍" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Delete" Click="DeleteHelp_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🧹" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Move to Folder" Click="MoveHelp_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="📦" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="CLI Usage" Click="CliHelp_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="⌨️" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="About" Click="About_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="ℹ️" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Margin="10">
            <!-- File Counter Tab -->
            <TabItem Header="File Counter">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="450"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Panel - Configuration (using Expanders now) -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Paths Input -->
                            <Expander Header="Paths to Scan" IsExpanded="True" Style="{StaticResource ExpanderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Enter paths (one per line):" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding PathsText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="120"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Button Content="Browse..." 
                                        Command="{Binding BrowseFolderCommand}"
                                        Style="{StaticResource ButtonStyle}"/>
                                        <Button Content="Import CSV" 
                                        Command="{Binding ImportFromCsvCommand}"
                                        Style="{StaticResource ButtonStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <!-- Scan Options -->
                            <Expander Header="Scan Options" IsExpanded="True" Style="{StaticResource ExpanderStyle}">
                                <!-- Keep existing scan options content -->
                                <StackPanel>
                                    <TextBlock Text="Count Mode:" Style="{StaticResource SectionHeaderStyle}"/>
                                    <ComboBox ItemsSource="{Binding CountModes}"
                                      SelectedItem="{Binding SelectedCountMode}"
                                      Margin="0,0,0,10"/>

                                    <CheckBox Content="Recursive scan"
                                      IsChecked="{Binding IsRecursive}"
                                      Margin="0,5"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="Max Depth:" VerticalAlignment="Center" Width="100"/>
                                        <TextBox Text="{Binding MaxDepthText, UpdateSourceTrigger=PropertyChanged}"
                                         Width="100"
                                         IsEnabled="{Binding IsRecursive}"
                                         PreviewTextInput="MaxDepth_PreviewTextInput"
                                         DataObject.Pasting="MaxDepth_Pasting"/>
                                        <TextBlock Text="(leave empty for unlimited)" 
                                           VerticalAlignment="Center" 
                                           Margin="5,0,0,0"
                                           FontSize="10"
                                           Foreground="Gray"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="Parallel Threads:" VerticalAlignment="Center" Width="100"/>
                                        <TextBox Text="{Binding ParallelThreadCount, UpdateSourceTrigger=PropertyChanged}"
                                         Width="100"/>
                                    </StackPanel>

                                    <CheckBox Content="Include hidden files"
                                      IsChecked="{Binding IncludeHiddenFiles}"
                                      Margin="0,5"/>

                                    <CheckBox Content="Enable file type breakdown"
                                      IsChecked="{Binding EnableFileTypeBreakdown}"
                                      Margin="0,5"/>
                                </StackPanel>
                            </Expander>

                            <!-- Box Drive Options -->
                            <Expander Header="Box Drive Options" IsExpanded="False" Style="{StaticResource ExpanderStyle}">
                                <!-- Keep existing Box Drive content -->
                                <StackPanel>
                                    <CheckBox Content="Enable Box Drive refresh"
                                      IsChecked="{Binding BoxDriveRefreshEnabled}"
                                      Margin="0,5"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="Timeout (seconds):" 
                                           VerticalAlignment="Center" 
                                           Width="120"/>
                                        <TextBox Text="{Binding BoxDriveRefreshTimeout, UpdateSourceTrigger=PropertyChanged}"
                                         Width="100"
                                         IsEnabled="{Binding BoxDriveRefreshEnabled}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <!-- File Type Filters -->
                            <Expander Header="File Type Filters" IsExpanded="False" Style="{StaticResource ExpanderStyle}">
                                <!-- Keep existing filters content -->
                                <StackPanel>
                                    <TextBlock Text="Include types (comma-separated):" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding IncludeFileTypes, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10"/>
                                    <TextBlock Text="Example: .docx, .pdf, .xlsx" 
                                       FontSize="10" 
                                       Foreground="Gray" 
                                       Margin="0,0,0,10"/>

                                    <TextBlock Text="Exclude types (comma-separated):" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding ExcludeFileTypes, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Example: .tmp, .log" 
                                       FontSize="10" 
                                       Foreground="Gray" 
                                       Margin="0,5,0,0"/>
                                </StackPanel>
                            </Expander>

                            <!-- CLI/Output Settings -->
                            <Expander Header="CLI / Output Settings" IsExpanded="False" Style="{StaticResource ExpanderStyle}">
                                <!-- Keep existing CLI settings content -->
                                <StackPanel>
                                    <TextBlock Text="Output Format:" Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding OutputFormats}"
                                      SelectedItem="{Binding OutputFormat}"
                                      Margin="0,0,0,10"/>

                                    <TextBlock Text="Output Path:" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,5"/>
                                    <TextBlock Text="Use {timestamp} for date/time" 
                                       FontSize="10" 
                                       Foreground="Gray" 
                                       Margin="0,0,0,10"/>

                                    <CheckBox Content="Enable scan history"
                                      IsChecked="{Binding EnableHistory}"
                                      Margin="0,5"/>

                                    <CheckBox Content="Enable comparison tracking"
                                      IsChecked="{Binding EnableComparison}"
                                      Margin="0,5"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="Retention (days):" 
                                           VerticalAlignment="Center" 
                                           Width="120"/>
                                        <TextBox Text="{Binding ComparisonRetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                         Width="100"
                                         IsEnabled="{Binding EnableComparison}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <!-- Saved Configurations -->
                            <Expander Header="Saved Configurations" IsExpanded="False" Style="{StaticResource ExpanderStyle}">
                                <!-- Keep existing saved configs content -->
                                <StackPanel>
                                    <ComboBox ItemsSource="{Binding SavedConfigurations}"
                                      SelectedItem="{Binding SelectedConfiguration}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Load" 
                                        Command="{Binding LoadConfigurationCommand}"
                                        Style="{StaticResource ButtonStyle}"
                                        IsEnabled="{Binding HasSelectedConfiguration}"/>
                                        <Button Content="Save Current" 
                                        Command="{Binding SaveConfigurationCommand}"
                                        Style="{StaticResource ButtonStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button Content="Start Scan"
                                Command="{Binding StartScanCommand}"
                                Style="{StaticResource ButtonStyle}"
                                IsEnabled="{Binding IsNotScanning}"
                                Background="#4CAF50"
                                Foreground="White"
                                FontWeight="Bold"
                                Padding="20,10"
                                MinWidth="120"/>
                                <Button Content="Cancel"
                                Command="{Binding CancelScanCommand}"
                                Style="{StaticResource ButtonStyle}"
                                IsEnabled="{Binding IsScanning}"
                                Background="#F44336"
                                Foreground="White"
                                Padding="20,10"
                                MinWidth="120"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" 
                          Width="5" 
                          HorizontalAlignment="Stretch" 
                          Background="#CCCCCC"/>

                    <!-- Right Panel - Results (keep existing) -->
                    <Grid Grid.Column="2">
                        <!-- Keep all existing scan results content -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Results Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                            <TextBlock Text="Scan Results" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ScanResults.Count, StringFormat=' ({0} items)'}" 
                               FontSize="14" 
                               VerticalAlignment="Center" 
                               Margin="5,0,0,0"/>
                            <Button Content="Clear Results" 
                            Command="{Binding ClearResultsCommand}"
                            Style="{StaticResource ButtonStyle}"
                            Margin="20,0,0,0"/>
                            <Button Content="Export to CSV" 
                            Command="{Binding ExportToCsvCommand}"
                            Style="{StaticResource ButtonStyle}"/>
                            <Button Content="Export to JSON" 
                            Command="{Binding ExportToJsonCommand}"
                            Style="{StaticResource ButtonStyle}"/>
                        </StackPanel>

                        <!-- Results DataGrid -->
                        <DataGrid Grid.Row="1" 
                          ItemsSource="{Binding ScanResults}"
                          SelectedItem="{Binding SelectedScanResult}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F5F5F5"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          Margin="5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Path" 
                                            Binding="{Binding Path}" 
                                            Width="2*"
                                            MinWidth="200"/>

                                <DataGridTextColumn Header="Status" 
                                            Binding="{Binding Status}" 
                                            Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" 
                                            Value="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Folders" 
                                            Binding="{Binding TotalFolders, StringFormat=N0}" 
                                            Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Files" 
                                            Binding="{Binding TotalFiles, StringFormat=N0}" 
                                            Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Size" 
                                            Binding="{Binding TotalSizeBytes, Converter={StaticResource BytesToSizeConverter}}" 
                                            Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Duration" 
                                            Binding="{Binding Duration, StringFormat='{}{0:mm}:{0:ss}'}" 
                                            Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridCheckBoxColumn Header="Box Drive" 
                                                Binding="{Binding IsBoxDrivePath, Mode=OneWay}" 
                                                Width="80">
                                    <DataGridCheckBoxColumn.ElementStyle>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </Style>
                                    </DataGridCheckBoxColumn.ElementStyle>
                                </DataGridCheckBoxColumn>

                                <DataGridCheckBoxColumn Header="Network" 
                                                Binding="{Binding IsNetworkPath, Mode=OneWay}" 
                                                Width="80">
                                    <DataGridCheckBoxColumn.ElementStyle>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </Style>
                                    </DataGridCheckBoxColumn.ElementStyle>
                                </DataGridCheckBoxColumn>

                                <DataGridTextColumn Header="Errors" 
                                            Binding="{Binding Errors.Count}" 
                                            Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Details Panel -->
                        <Expander Grid.Row="2" 
                          Header="Details" 
                          IsExpanded="False"
                          Margin="5"
                          Visibility="{Binding SelectedScanResult, Converter={StaticResource BoolToVisConverter}}">
                            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Text="{Binding SelectedScanResult.Path, StringFormat='Path: {0}'}" 
                                       FontWeight="SemiBold" 
                                       Margin="0,0,0,10"/>

                                    <TextBlock Text="{Binding SelectedScanResult.GetStatusDescription, StringFormat='Status: {0}'}" 
                                       Margin="0,0,0,5"/>

                                    <TextBlock Text="{Binding SelectedScanResult.StartTime, StringFormat='Start Time: {0:yyyy-MM-dd HH:mm:ss}'}" 
                                       Margin="0,0,0,5"/>

                                    <TextBlock Margin="0,10,0,5" 
                                       FontWeight="SemiBold"
                                       Visibility="{Binding SelectedScanResult.HasErrors, Converter={StaticResource BoolToVisConverter}}">
                                <Run Text="Errors ("/><Run Text="{Binding SelectedScanResult.Errors.Count, Mode=OneWay}"/><Run Text="):"/>
                                    </TextBlock>

                                    <ItemsControl ItemsSource="{Binding SelectedScanResult.Errors}"
                                          Visibility="{Binding SelectedScanResult.HasErrors, Converter={StaticResource BoolToVisConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,2">
                                            <Run Text="• " Foreground="Red"/>
                                            <Run Text="{Binding ErrorType, Mode=OneWay}" FontWeight="SemiBold" Foreground="Red"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding Message, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Cleanup Tab -->
            <TabItem Header="Delete">
                <TabItem.DataContext>
                    <Binding Path="DeleteViewModel" RelativeSource="{RelativeSource AncestorType=Window}"/>
                </TabItem.DataContext>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="450"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Panel - Cleanup Configuration -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Paths to Clean -->
                            <Expander Header="Paths to Clean" IsExpanded="True" Style="{StaticResource ExpanderStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding PathsHintText}" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding PathsText, UpdateSourceTrigger=PropertyChanged}"
                 Height="120"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Button Content="Browse..." 
                    Command="{Binding BrowseFolderCommand}"
                    Style="{StaticResource ButtonStyle}"/>
                                        <Button Content="Import CSV" 
                    Command="{Binding ImportFromCsvCommand}"
                    Style="{StaticResource ButtonStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <!-- Cleanup Target -->
                            <Expander Header="Cleanup Target" IsExpanded="True" Style="{StaticResource ExpanderStyle}">
                                <StackPanel>
                                    <TextBlock Text="What to clean:" Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding DeleteViewModel.CleanupTargets, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding DeleteViewModel.SelectedTarget, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Margin="0,0,0,10"/>

                                    <CheckBox Content="Recursive scan"
                                  IsChecked="{Binding DeleteViewModel.IsRecursive, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Margin="0,5"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="Max Depth:" VerticalAlignment="Center" Width="100"/>
                                        <TextBox Text="{Binding DeleteViewModel.MaxDepthText, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Width="100"
                                     IsEnabled="{Binding DeleteViewModel.IsRecursive, RelativeSource={RelativeSource AncestorType=Window}}"
                                     PreviewTextInput="MaxDepth_PreviewTextInput"
                                     DataObject.Pasting="MaxDepth_Pasting"/>
                                        <TextBlock Text="(leave empty for unlimited)" 
                                                    VerticalAlignment="Center" 
                                                    Margin="5,0,0,0"
                                                    FontSize="10"
                                                    Foreground="Gray"/>
                                    </StackPanel>

                                    <CheckBox Content="Include hidden files"
                                  IsChecked="{Binding DeleteViewModel.IncludeHiddenFiles, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Margin="0,5"/>
                                </StackPanel>
                            </Expander>

                            <!-- Date Criteria -->
                            <Expander Header="Date Criteria" IsExpanded="True" Style="{StaticResource ExpanderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Date Mode:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding DateModes}"
                  SelectedItem="{Binding SelectedDateMode}"
                  Margin="0,0,0,10"/>

                                    <!-- Help Text -->
                                    <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="Gray" Margin="0,0,0,10">
            <Run Text="Select how to filter files/folders by date."/>
                                    </TextBlock>

                                    <!-- Any Date (no date filtering) -->
                                    <StackPanel Visibility="{Binding SelectedDateMode, Converter={StaticResource DateModeToVisConverter}, ConverterParameter=AnyDate}">
                                        <TextBlock Text="No date filtering will be applied." 
                       FontStyle="Italic" 
                       Foreground="Green" 
                       Margin="0,5"/>
                                    </StackPanel>

                                    <!-- Older Than / Newer Than -->
                                    <StackPanel Visibility="{Binding SelectedDateMode, Converter={StaticResource DateModeToVisConverter}, ConverterParameter='OlderThan,NewerThan'}">
                                        <TextBlock Margin="0,5,0,5" FontSize="11">
        <Run Text="Select cutoff date and time."/>
        <LineBreak/>
        <Run Text="Files " FontWeight="SemiBold"/>
        <Run Text="{Binding SelectedDateMode, Mode=OneWay}" FontWeight="SemiBold"/>
        <Run Text=" this date/time will be identified." FontWeight="SemiBold"/>
                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="Cutoff Date:" VerticalAlignment="Center" Width="80"/>
                                            <DatePicker SelectedDate="{Binding CutoffDate}"
                   Width="150"/>
                                            <Button Content="📅 Today"
                    Command="{Binding SetCutoffToNowCommand}"
                    Padding="5,3" Margin="6,0,0,0" FontSize="11"
                    ToolTip="Set cutoff date and time to right now"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="Cutoff Time:" VerticalAlignment="Center" Width="80"/>
                                            <TextBox Text="{Binding CutoffTimeHour, UpdateSourceTrigger=PropertyChanged}"
                 Width="35"
                 MaxLength="2"
                 Margin="0,0,3,0"
                 ToolTip="Hour (1–12)"/>
                                            <TextBlock Text=":" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding CutoffTimeMinute, UpdateSourceTrigger=PropertyChanged}"
                 Width="35"
                 MaxLength="2"
                 Margin="3,0,5,0"
                 ToolTip="Minute (00–59)"/>
                                            <ComboBox ItemsSource="{Binding AmPmOptions}"
                  SelectedItem="{Binding CutoffTimeAmPm}"
                  Width="55"
                  Margin="0,0,8,0"/>
                                        </StackPanel>

                                        <Border Background="#E3F2FD" 
            BorderBrush="#2196F3" 
            BorderThickness="1" 
            Padding="8" 
            Margin="0,10,0,0"
            CornerRadius="3">
                                            <TextBlock TextWrapping="Wrap" FontSize="10">
            <Run Text="Example: " FontWeight="Bold"/>
            <Run Text="For 'OlderThan' mode, setting date to today and time to 1:00 PM will identify all files modified before 1:00 PM today."/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <!-- Exact Date -->
                                    <StackPanel Visibility="{Binding SelectedDateMode, Converter={StaticResource DateModeToVisConverter}, ConverterParameter=ExactDate}">
                                        <TextBlock Text="Select the exact date:" Margin="0,5,0,5" FontSize="11"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="Date:" VerticalAlignment="Center" Width="80"/>
                                            <DatePicker SelectedDate="{Binding StartDate}"
                           Width="150"/>
                                            <Button Content="📅 Today"
                    Command="{Binding SetStartToNowCommand}"
                    Padding="5,3" Margin="6,0,0,0" FontSize="11"
                    ToolTip="Set date and time to right now"/>
                                        </StackPanel>

                                        <!-- Time option for exact date -->
                                        <CheckBox Content="Include specific time"
                      IsChecked="{Binding IncludeTime}"
                      Margin="0,10,0,5"/>

                                        <StackPanel Orientation="Horizontal"
                       Margin="0,5"
                       IsEnabled="{Binding IncludeTime}">
                                            <TextBlock Text="Time:" VerticalAlignment="Center" Width="80"/>
                                            <TextBox Text="{Binding StartTimeHour, UpdateSourceTrigger=PropertyChanged}"
                         Width="35"
                         MaxLength="2"
                         Margin="0,0,3,0"
                         ToolTip="Hour (1–12)"/>
                                            <TextBlock Text=":" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding StartTimeMinute, UpdateSourceTrigger=PropertyChanged}"
                         Width="35"
                         MaxLength="2"
                         Margin="3,0,5,0"
                         ToolTip="Minute (00–59)"/>
                                            <ComboBox ItemsSource="{Binding AmPmOptions}"
                          SelectedItem="{Binding StartTimeAmPm}"
                          Width="55"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Date Range -->
                                    <StackPanel Visibility="{Binding SelectedDateMode, Converter={StaticResource DateModeToVisConverter}, ConverterParameter=DateRange}">
                                        <TextBlock Text="Select date range:" Margin="0,5,0,5" FontSize="11"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="Past Date:" VerticalAlignment="Center" Width="80"/>
                                            <DatePicker SelectedDate="{Binding StartDate}"
                           Width="150"/>
                                            <Button Content="📅 Today"
                    Command="{Binding SetStartToNowCommand}"
                    Padding="5,3" Margin="6,0,0,0" FontSize="11"
                    ToolTip="Set start date and time to right now"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="Recent Date:" VerticalAlignment="Center" Width="80"/>
                                            <DatePicker SelectedDate="{Binding EndDate}"
                           Width="150"/>
                                            <Button Content="📅 Today"
                    Command="{Binding SetEndToNowCommand}"
                    Padding="5,3" Margin="6,0,0,0" FontSize="11"
                    ToolTip="Set end date and time to right now"/>
                                        </StackPanel>

                                        <!-- Time options for date range -->
                                        <CheckBox Content="Include specific times"
                      IsChecked="{Binding IncludeTime}"
                      Margin="0,10,0,5"/>

                                        <!-- Start Time -->
                                        <StackPanel Orientation="Horizontal"
                       Margin="0,5"
                       IsEnabled="{Binding IncludeTime}">
                                            <TextBlock Text="Start Time:" VerticalAlignment="Center" Width="80"/>
                                            <TextBox Text="{Binding StartTimeHour, UpdateSourceTrigger=PropertyChanged}"
                         Width="35"
                         MaxLength="2"
                         Margin="0,0,3,0"
                         ToolTip="Hour (1–12)"/>
                                            <TextBlock Text=":" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding StartTimeMinute, UpdateSourceTrigger=PropertyChanged}"
                         Width="35"
                         MaxLength="2"
                         Margin="3,0,5,0"
                         ToolTip="Minute (00–59)"/>
                                            <ComboBox ItemsSource="{Binding AmPmOptions}"
                          SelectedItem="{Binding StartTimeAmPm}"
                          Width="55"/>
                                        </StackPanel>

                                        <!-- End Time -->
                                        <StackPanel Orientation="Horizontal"
                       Margin="0,5"
                       IsEnabled="{Binding IncludeTime}">
                                            <TextBlock Text="End Time:" VerticalAlignment="Center" Width="80"/>
                                            <TextBox Text="{Binding EndTimeHour, UpdateSourceTrigger=PropertyChanged}"
                         Width="35"
                         MaxLength="2"
                         Margin="0,0,3,0"
                         ToolTip="Hour (1–12)"/>
                                            <TextBlock Text=":" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding EndTimeMinute, UpdateSourceTrigger=PropertyChanged}"
                         Width="35"
                         MaxLength="2"
                         Margin="3,0,5,0"
                         ToolTip="Minute (00–59)"/>
                                            <ComboBox ItemsSource="{Binding AmPmOptions}"
                          SelectedItem="{Binding EndTimeAmPm}"
                          Width="55"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Date filtering summary -->
                                    <Border Background="#F0F0F0" 
                Padding="10" 
                Margin="0,10,0,0"
                CornerRadius="3">
                                        <TextBlock TextWrapping="Wrap" FontSize="10">
                <Run Text="💡 Tip: " FontWeight="Bold"/>
                <Run Text="Use 'AnyDate' to clean files regardless of date. Use 'OlderThan' for cleanup tasks like removing files older than 30 days."/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Expander>

                            <!-- File Type Filters -->
                            <Expander Header="File Type Filters" IsExpanded="False" Style="{StaticResource ExpanderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Include types (comma-separated):" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding DeleteViewModel.IncludeFileTypes, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Margin="0,0,0,10"/>
                                    <TextBlock Text="Example: .docx, .pdf, .xlsx" 
                                   FontSize="10" 
                                   Foreground="Gray" 
                                   Margin="0,0,0,10"/>

                                    <TextBlock Text="Exclude types (comma-separated):" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding DeleteViewModel.ExcludeFileTypes, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <TextBlock Text="Example: .tmp, .log" 
                                   FontSize="10" 
                                   Foreground="Gray" 
                                   Margin="0,5,0,10"/>

                                    <TextBlock Text="Exclude patterns (one per line):" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding DeleteViewModel.ExcludePatterns, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Height="60"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                                    <TextBlock Text="Example: .*backup.*, .*temp.*" 
                                   FontSize="10" 
                                   Foreground="Gray" 
                                   Margin="0,5,0,0"/>
                                </StackPanel>
                            </Expander>

                            <!-- Safety Options -->
                            <Expander Header="Safety Options" IsExpanded="True" Style="{StaticResource ExpanderStyle}">
                                <StackPanel>
                                    <CheckBox Content="Dry Run (preview only)"
                                  IsChecked="{Binding DeleteViewModel.DryRun, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Margin="0,5"
                                  FontWeight="Bold"
                                  Foreground="Red"/>

                                    <CheckBox Content="Require confirmation"
                                  IsChecked="{Binding DeleteViewModel.RequireConfirmation, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Margin="0,5"/>

                                    <CheckBox Content="Move to Recycle Bin (vs permanent delete)"
                                  IsChecked="{Binding DeleteViewModel.MoveToRecycleBin, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Margin="0,5"/>
                                </StackPanel>
                            </Expander>


                            <!-- Saved Configurations -->
                            <Expander Header="Saved Configurations" IsExpanded="False" Style="{StaticResource ExpanderStyle}">
                                <StackPanel>
                                    <ComboBox ItemsSource="{Binding SavedConfigurations}"
                  SelectedItem="{Binding SelectedConfiguration}"
                  DisplayMemberPath="Name"
                  Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Load" 
                    Command="{Binding LoadConfigurationCommand}"
                    Style="{StaticResource ButtonStyle}"
                    IsEnabled="{Binding HasSelectedConfiguration}"/>
                                        <Button Content="Save Current" 
                    Command="{Binding SaveConfigurationCommand}"
                    Style="{StaticResource ButtonStyle}"/>
                                    </StackPanel>

                                    <TextBlock Text="💾 Configurations can be used with CLI for scheduled tasks" 
                   TextWrapping="Wrap"
                   FontSize="10"
                   Foreground="Gray"
                   Margin="0,10,0,0"/>
                                </StackPanel>
                            </Expander>


                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button Content="Analyze"
                            Command="{Binding DeleteViewModel.AnalyzeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource ButtonStyle}"
                            IsEnabled="{Binding DeleteViewModel.IsNotAnalyzing, RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="#2196F3"
                            Foreground="White"
                            FontWeight="Bold"
                            Padding="20,10"
                            MinWidth="120"/>
                                <Button Content="{Binding DeleteViewModel.ExecuteButtonLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                            Command="{Binding DeleteViewModel.ExecuteCleanupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource ButtonStyle}"
                            IsEnabled="{Binding DeleteViewModel.IsNotDeleting, RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="#FF9800"
                            Foreground="White"
                            FontWeight="Bold"
                            Padding="20,10"
                            MinWidth="120"/>
                                <Button Content="Cancel"
                            Command="{Binding DeleteViewModel.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource ButtonStyle}"
                            Background="#F44336"
                            Foreground="White"
                            Padding="20,10"
                            MinWidth="120"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" 
                      Width="5" 
                      HorizontalAlignment="Stretch" 
                      Background="#CCCCCC"/>

                    <!-- Right Panel - Results -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Results Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                            <TextBlock Text="Delete Analysis"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DeleteViewModel.AnalysisResults.Count, StringFormat=' ({0} paths)', RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="5,0,0,0"/>
                            <Button Content="Clear Results"
                        Command="{Binding DeleteViewModel.ClearResultsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource ButtonStyle}"
                        Margin="20,0,0,0"/>
                            <Button Content="Export Results"
                        Command="{Binding DeleteViewModel.ExportResultsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource ButtonStyle}"/>
                        </StackPanel>

                        <!-- DryRun "PREVIEW ONLY" banner — visible after a simulation run -->
                        <Border Grid.Row="1"
                                Background="#FFF9C4" BorderBrush="#F9A825" BorderThickness="1"
                                Padding="10,5" Margin="5,0,5,4"
                                Visibility="{Binding DeleteViewModel.ShowDryRunBanner,
                                             RelativeSource={RelativeSource AncestorType=Window},
                                             Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="⚠  PREVIEW ONLY — Dry Run is ON. The items below have NOT been modified."
                                       FontWeight="SemiBold" Foreground="#E65100"/>
                        </Border>

                        <!-- Results List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="5">
                            <ItemsControl ItemsSource="{Binding DeleteViewModel.AnalysisResults, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Header="{Binding Path}" IsExpanded="True" Margin="0,5">
                                            <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Background="White">
                                                <StackPanel>
                                                    <!-- Summary -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding FilesIdentified, StringFormat='Files Identified: {0:N0}'}" 
                                                           FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding FoldersIdentified, StringFormat='Folders Identified: {0:N0}'}" 
                                                           FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding SizeFormatted, StringFormat='Total Size: {0}'}" 
                                                           FontWeight="SemiBold"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1">
                                                            <!-- Real delete stats (hidden during DryRun) -->
                                                            <TextBlock Text="{Binding FilesDeleted, StringFormat='Files Deleted: {0:N0}'}"
                                                                       Foreground="Red" FontWeight="SemiBold"
                                                                       Visibility="{Binding WasDryRun, Converter={StaticResource BoolToVisConverter}, ConverterParameter=invert}"/>
                                                            <TextBlock Text="{Binding FoldersDeleted, StringFormat='Folders Deleted: {0:N0}'}"
                                                                       Foreground="Red" FontWeight="SemiBold"
                                                                       Visibility="{Binding WasDryRun, Converter={StaticResource BoolToVisConverter}, ConverterParameter=invert}"/>
                                                            <!-- DryRun simulation stats (only visible during DryRun) -->
                                                            <TextBlock Text="{Binding FilesWouldDelete, StringFormat='Would Delete: {0:N0} files'}"
                                                                       Foreground="DarkOrange" FontWeight="SemiBold"
                                                                       Visibility="{Binding WasDryRun, Converter={StaticResource BoolToVisConverter}}"/>
                                                            <TextBlock Text="{Binding FoldersWouldDelete, StringFormat='Would Delete: {0:N0} folders'}"
                                                                       Foreground="DarkOrange" FontWeight="SemiBold"
                                                                       Visibility="{Binding WasDryRun, Converter={StaticResource BoolToVisConverter}}"/>
                                                            <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}"
                                                                       FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Items List (expandable) -->
                                                    <Expander Header="Items to Delete" IsExpanded="True" Margin="0,10,0,0">
                                                        <DataGrid ItemsSource="{Binding Items}"
                                                                  AutoGenerateColumns="False"
                                                                  IsReadOnly="True"
                                                                  MaxHeight="300"
                                                                  GridLinesVisibility="Horizontal"
                                                                  AlternatingRowBackground="#F5F5F5">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*"/>
                                                                <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="80"/>
                                                                <DataGridTextColumn Header="Last Modified"
                                                                                    Binding="{Binding LastModified, StringFormat='yyyy-MM-dd hh:mm:ss tt'}"
                                                                                    Width="170"/>
                                                                <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes}" Width="100">
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                                        </Style>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>
                                                                <!-- Action column replaces the boolean "Deleted" checkbox.
                                                                     Shows "Deleted", "Would Delete", "Error", or "Identified"
                                                                     via CleanupItem.DeleteActionLabel. -->
                                                                <DataGridTextColumn Header="Action"
                                                                                    Binding="{Binding DeleteActionLabel}"
                                                                                    Width="110"/>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </Expander>

                                                    <!-- Errors (if any) -->
                                                    <StackPanel Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisConverter}}" 
                                                   Margin="0,10,0,0">
                                                        <TextBlock Text="Errors:" FontWeight="Bold" Foreground="Red"/>
                                                        <ItemsControl ItemsSource="{Binding Errors}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Margin="10,2,0,0">
                                                            <Run Text="• " Foreground="Red"/>
                                                            <Run Text="{Binding Path, Mode=OneWay}"/>
                                                            <Run Text=": "/>
                                                            <Run Text="{Binding Message, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
            <!-- Move to Folder Tab -->
            <TabItem Header="Move to Folder">
                <TabItem.DataContext>
                    <Binding Path="MoveViewModel" RelativeSource="{RelativeSource AncestorType=Window}"/>
                </TabItem.DataContext>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="450"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Panel - Move Configuration -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Move Operation -->
                            <Expander Header="Move Operation" IsExpanded="True" Style="{StaticResource ExpanderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Input Mode:" Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding MoveInputModes}"
                                              SelectedItem="{Binding MoveInputMode}"
                                              Margin="0,0,0,10"/>

                                    <!-- Single Move Panel -->
                                    <StackPanel Visibility="{Binding IsSingleMoveMode, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="Source folder:" Margin="0,0,0,5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding SingleSourcePath, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,4,0"/>
                                            <Button Grid.Column="1" Content="Browse..."
                                                    Command="{Binding BrowseSingleSourceCommand}"
                                                    Style="{StaticResource ButtonStyle}"/>
                                        </Grid>
                                        <TextBlock Text="Destination folder:" Margin="0,8,0,5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding SingleDestinationPath, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,4,0"/>
                                            <Button Grid.Column="1" Content="Browse..."
                                                    Command="{Binding BrowseSingleDestinationCommand}"
                                                    Style="{StaticResource ButtonStyle}"/>
                                        </Grid>
                                        <TextBlock Text="Relative path structure is preserved at destination."
                                                   FontSize="10" Foreground="Gray" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Batch Move Panel -->
                                    <StackPanel Visibility="{Binding IsBatchMoveMode, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="{Binding PathsHintText}" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding PathsText, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="120"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 FontFamily="Consolas"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Button Content="Browse..."
                                                    Command="{Binding BrowseFolderCommand}"
                                                    Style="{StaticResource ButtonStyle}"/>
                                            <Button Content="Import CSV"
                                                    Command="{Binding ImportFromCsvCommand}"
                                                    Style="{StaticResource ButtonStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <!-- Cleanup Target -->
                            <Expander Header="Cleanup Target" IsExpanded="True" Style="{StaticResource ExpanderStyle}">
                                <StackPanel>
                                    <TextBlock Text="What to move:" Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding MoveViewModel.CleanupTargets, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding MoveViewModel.SelectedTarget, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Margin="0,0,0,10"/>

                                    <CheckBox Content="Recursive scan"
                                              IsChecked="{Binding MoveViewModel.IsRecursive, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Margin="0,5"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <TextBlock Text="Max Depth:" VerticalAlignment="Center" Width="100"/>
                                        <TextBox Text="{Binding MoveViewModel.MaxDepthText, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Width="100"
                                                 IsEnabled="{Binding MoveViewModel.IsRecursive, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 PreviewTextInput="MaxDepth_PreviewTextInput"
                                                 DataObject.Pasting="MaxDepth_Pasting"/>
                                        <TextBlock Text="(leave empty for unlimited)"
                                                   VerticalAlignment="Center"
                                                   Margin="5,0,0,0"
                                                   FontSize="10"
                                                   Foreground="Gray"/>
                                    </StackPanel>

                                    <CheckBox Content="Include hidden files"
                                              IsChecked="{Binding MoveViewModel.IncludeHiddenFiles, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Margin="0,5"/>
                                </StackPanel>
                            </Expander>

                            <!-- Date Criteria -->
                            <Expander Header="Date Criteria" IsExpanded="True" Style="{StaticResource ExpanderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Date Mode:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding DateModes}"
                                              SelectedItem="{Binding SelectedDateMode}"
                                              Margin="0,0,0,10"/>

                                    <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="Gray" Margin="0,0,0,10">
                                        <Run Text="Select how to filter files/folders by date."/>
                                    </TextBlock>

                                    <!-- Any Date -->
                                    <StackPanel Visibility="{Binding SelectedDateMode, Converter={StaticResource DateModeToVisConverter}, ConverterParameter=AnyDate}">
                                        <TextBlock Text="No date filtering will be applied."
                                                   FontStyle="Italic" Foreground="Green" Margin="0,5"/>
                                    </StackPanel>

                                    <!-- Older Than / Newer Than -->
                                    <StackPanel Visibility="{Binding SelectedDateMode, Converter={StaticResource DateModeToVisConverter}, ConverterParameter='OlderThan,NewerThan'}">
                                        <TextBlock Margin="0,5,0,5" FontSize="11">
                                            <Run Text="Select cutoff date and time."/>
                                            <LineBreak/>
                                            <Run Text="Files " FontWeight="SemiBold"/>
                                            <Run Text="{Binding SelectedDateMode, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=" this date/time will be identified." FontWeight="SemiBold"/>
                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="Cutoff Date:" VerticalAlignment="Center" Width="80"/>
                                            <DatePicker SelectedDate="{Binding CutoffDate}" Width="150"/>
                                            <Button Content="&#x1F4C5; Today"
                                                    Command="{Binding SetCutoffToNowCommand}"
                                                    Padding="5,3" Margin="6,0,0,0" FontSize="11"
                                                    ToolTip="Set cutoff date and time to right now"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="Cutoff Time:" VerticalAlignment="Center" Width="80"/>
                                            <TextBox Text="{Binding CutoffTimeHour, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="35" MaxLength="2" Margin="0,0,3,0" ToolTip="Hour (1-12)"/>
                                            <TextBlock Text=":" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding CutoffTimeMinute, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="35" MaxLength="2" Margin="3,0,5,0" ToolTip="Minute (00-59)"/>
                                            <ComboBox ItemsSource="{Binding AmPmOptions}"
                                                      SelectedItem="{Binding CutoffTimeAmPm}"
                                                      Width="55" Margin="0,0,8,0"/>
                                        </StackPanel>

                                        <Border Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="1"
                                                Padding="8" Margin="0,10,0,0" CornerRadius="3">
                                            <TextBlock TextWrapping="Wrap" FontSize="10">
                                                <Run Text="Example: " FontWeight="Bold"/>
                                                <Run Text="For 'OlderThan' mode, setting date to today and time to 1:00 PM will identify all files modified before 1:00 PM today."/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <!-- Exact Date -->
                                    <StackPanel Visibility="{Binding SelectedDateMode, Converter={StaticResource DateModeToVisConverter}, ConverterParameter=ExactDate}">
                                        <TextBlock Text="Select the exact date:" Margin="0,5,0,5" FontSize="11"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="Date:" VerticalAlignment="Center" Width="80"/>
                                            <DatePicker SelectedDate="{Binding StartDate}" Width="150"/>
                                            <Button Content="&#x1F4C5; Today"
                                                    Command="{Binding SetStartToNowCommand}"
                                                    Padding="5,3" Margin="6,0,0,0" FontSize="11"
                                                    ToolTip="Set date and time to right now"/>
                                        </StackPanel>

                                        <CheckBox Content="Include specific time"
                                                  IsChecked="{Binding IncludeTime}" Margin="0,10,0,5"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,5" IsEnabled="{Binding IncludeTime}">
                                            <TextBlock Text="Time:" VerticalAlignment="Center" Width="80"/>
                                            <TextBox Text="{Binding StartTimeHour, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="35" MaxLength="2" Margin="0,0,3,0" ToolTip="Hour (1-12)"/>
                                            <TextBlock Text=":" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding StartTimeMinute, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="35" MaxLength="2" Margin="3,0,5,0" ToolTip="Minute (00-59)"/>
                                            <ComboBox ItemsSource="{Binding AmPmOptions}"
                                                      SelectedItem="{Binding StartTimeAmPm}" Width="55"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Date Range -->
                                    <StackPanel Visibility="{Binding SelectedDateMode, Converter={StaticResource DateModeToVisConverter}, ConverterParameter=DateRange}">
                                        <TextBlock Text="Select date range:" Margin="0,5,0,5" FontSize="11"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="Past Date:" VerticalAlignment="Center" Width="80"/>
                                            <DatePicker SelectedDate="{Binding StartDate}" Width="150"/>
                                            <Button Content="&#x1F4C5; Today"
                                                    Command="{Binding SetStartToNowCommand}"
                                                    Padding="5,3" Margin="6,0,0,0" FontSize="11"
                                                    ToolTip="Set start date and time to right now"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="Recent Date:" VerticalAlignment="Center" Width="80"/>
                                            <DatePicker SelectedDate="{Binding EndDate}" Width="150"/>
                                            <Button Content="&#x1F4C5; Today"
                                                    Command="{Binding SetEndToNowCommand}"
                                                    Padding="5,3" Margin="6,0,0,0" FontSize="11"
                                                    ToolTip="Set end date and time to right now"/>
                                        </StackPanel>

                                        <CheckBox Content="Include specific times"
                                                  IsChecked="{Binding IncludeTime}" Margin="0,10,0,5"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,5" IsEnabled="{Binding IncludeTime}">
                                            <TextBlock Text="Start Time:" VerticalAlignment="Center" Width="80"/>
                                            <TextBox Text="{Binding StartTimeHour, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="35" MaxLength="2" Margin="0,0,3,0" ToolTip="Hour (1-12)"/>
                                            <TextBlock Text=":" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding StartTimeMinute, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="35" MaxLength="2" Margin="3,0,5,0" ToolTip="Minute (00-59)"/>
                                            <ComboBox ItemsSource="{Binding AmPmOptions}"
                                                      SelectedItem="{Binding StartTimeAmPm}" Width="55"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,5" IsEnabled="{Binding IncludeTime}">
                                            <TextBlock Text="End Time:" VerticalAlignment="Center" Width="80"/>
                                            <TextBox Text="{Binding EndTimeHour, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="35" MaxLength="2" Margin="0,0,3,0" ToolTip="Hour (1-12)"/>
                                            <TextBlock Text=":" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding EndTimeMinute, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="35" MaxLength="2" Margin="3,0,5,0" ToolTip="Minute (00-59)"/>
                                            <ComboBox ItemsSource="{Binding AmPmOptions}"
                                                      SelectedItem="{Binding EndTimeAmPm}" Width="55"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Date filtering tip -->
                                    <Border Background="#F0F0F0" Padding="10" Margin="0,10,0,0" CornerRadius="3">
                                        <TextBlock TextWrapping="Wrap" FontSize="10">
                                            <Run Text="&#x1F4A1; Tip: " FontWeight="Bold"/>
                                            <Run Text="Use 'AnyDate' to move files regardless of date. Use 'OlderThan' for archiving files older than a specific date."/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Expander>

                            <!-- File Type Filters -->
                            <Expander Header="File Type Filters" IsExpanded="False" Style="{StaticResource ExpanderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Include types (comma-separated):" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding MoveViewModel.IncludeFileTypes, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Margin="0,0,0,10"/>
                                    <TextBlock Text="Example: .docx, .pdf, .xlsx"
                                               FontSize="10" Foreground="Gray" Margin="0,0,0,10"/>

                                    <TextBlock Text="Exclude types (comma-separated):" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding MoveViewModel.ExcludeFileTypes, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <TextBlock Text="Example: .tmp, .log"
                                               FontSize="10" Foreground="Gray" Margin="0,5,0,10"/>

                                    <TextBlock Text="Exclude patterns (one per line):" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding MoveViewModel.ExcludePatterns, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Height="60"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"/>
                                    <TextBlock Text="Example: .*backup.*, .*temp.*"
                                               FontSize="10" Foreground="Gray" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Expander>

                            <!-- Safety Options -->
                            <Expander Header="Safety Options" IsExpanded="True" Style="{StaticResource ExpanderStyle}">
                                <StackPanel>
                                    <CheckBox Content="Dry Run (preview only)"
                                              IsChecked="{Binding MoveViewModel.DryRun, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Margin="0,5"
                                              FontWeight="Bold"
                                              Foreground="Red"/>

                                    <CheckBox Content="Require confirmation"
                                              IsChecked="{Binding MoveViewModel.RequireConfirmation, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Margin="0,5"/>
                                </StackPanel>
                            </Expander>

                            <!-- Saved Configurations -->
                            <Expander Header="Saved Configurations" IsExpanded="False" Style="{StaticResource ExpanderStyle}">
                                <StackPanel>
                                    <ComboBox ItemsSource="{Binding SavedConfigurations}"
                                              SelectedItem="{Binding SelectedConfiguration}"
                                              DisplayMemberPath="Name"
                                              Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Load"
                                                Command="{Binding LoadConfigurationCommand}"
                                                Style="{StaticResource ButtonStyle}"
                                                IsEnabled="{Binding HasSelectedConfiguration}"/>
                                        <Button Content="Save Current"
                                                Command="{Binding SaveConfigurationCommand}"
                                                Style="{StaticResource ButtonStyle}"/>
                                    </StackPanel>

                                    <TextBlock Text="&#x1F4BE; Configurations can be used with CLI for scheduled tasks"
                                               TextWrapping="Wrap"
                                               FontSize="10"
                                               Foreground="Gray"
                                               Margin="0,10,0,0"/>
                                </StackPanel>
                            </Expander>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button Content="Analyze"
                                        Command="{Binding MoveViewModel.AnalyzeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Style="{StaticResource ButtonStyle}"
                                        IsEnabled="{Binding MoveViewModel.IsNotAnalyzing, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Background="#2196F3"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        Padding="20,10"
                                        MinWidth="120"/>
                                <Button Content="{Binding MoveViewModel.ExecuteButtonLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Command="{Binding MoveViewModel.ExecuteCleanupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Style="{StaticResource ButtonStyle}"
                                        IsEnabled="{Binding MoveViewModel.IsNotDeleting, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Background="#4CAF50"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        Padding="20,10"
                                        MinWidth="120"/>
                                <Button Content="Cancel"
                                        Command="{Binding MoveViewModel.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Style="{StaticResource ButtonStyle}"
                                        Background="#F44336"
                                        Foreground="White"
                                        Padding="20,10"
                                        MinWidth="120"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1"
                                  Width="5"
                                  HorizontalAlignment="Stretch"
                                  Background="#CCCCCC"/>

                    <!-- Right Panel - Move Analysis Results -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Results Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                            <TextBlock Text="Move Analysis"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MoveViewModel.AnalysisResults.Count, StringFormat=' ({0} paths)', RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="5,0,0,0"/>
                            <Button Content="Clear Results"
                                    Command="{Binding MoveViewModel.ClearResultsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource ButtonStyle}"
                                    Margin="20,0,0,0"/>
                            <Button Content="Export Results"
                                    Command="{Binding MoveViewModel.ExportResultsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource ButtonStyle}"/>
                        </StackPanel>

                        <!-- DryRun "PREVIEW ONLY" banner — visible after a simulation run -->
                        <Border Grid.Row="1"
                                Background="#FFF9C4" BorderBrush="#F9A825" BorderThickness="1"
                                Padding="10,5" Margin="5,0,5,4"
                                Visibility="{Binding MoveViewModel.ShowDryRunBanner,
                                             RelativeSource={RelativeSource AncestorType=Window},
                                             Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="⚠  PREVIEW ONLY — Dry Run is ON. The items below have NOT been modified."
                                       FontWeight="SemiBold" Foreground="#E65100"/>
                        </Border>

                        <!-- Results List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="5">
                            <ItemsControl ItemsSource="{Binding MoveViewModel.AnalysisResults, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Header="{Binding Path}" IsExpanded="True" Margin="0,5">
                                            <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Background="White">
                                                <StackPanel>
                                                    <!-- Summary -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding FilesIdentified, StringFormat='Files Identified: {0:N0}'}"
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding FoldersIdentified, StringFormat='Folders Identified: {0:N0}'}"
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding SizeFormatted, StringFormat='Total Size: {0}'}"
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding DestinationPath, StringFormat='Destination: {0}'}"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="#555"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1">
                                                            <!-- Real move stats (hidden during DryRun) -->
                                                            <TextBlock Text="{Binding FilesMoved, StringFormat='Files Moved: {0:N0}'}"
                                                                       Foreground="Green" FontWeight="SemiBold"
                                                                       Visibility="{Binding WasDryRun, Converter={StaticResource BoolToVisConverter}, ConverterParameter=invert}"/>
                                                            <TextBlock Text="{Binding FoldersMoved, StringFormat='Folders Moved: {0:N0}'}"
                                                                       Foreground="Green" FontWeight="SemiBold"
                                                                       Visibility="{Binding WasDryRun, Converter={StaticResource BoolToVisConverter}, ConverterParameter=invert}"/>
                                                            <!-- DryRun simulation stats (only visible during DryRun) -->
                                                            <TextBlock Text="{Binding FilesWouldMove, StringFormat='Would Move: {0:N0} files'}"
                                                                       Foreground="DarkOrange" FontWeight="SemiBold"
                                                                       Visibility="{Binding WasDryRun, Converter={StaticResource BoolToVisConverter}}"/>
                                                            <TextBlock Text="{Binding FoldersWouldMove, StringFormat='Would Move: {0:N0} folders'}"
                                                                       Foreground="DarkOrange" FontWeight="SemiBold"
                                                                       Visibility="{Binding WasDryRun, Converter={StaticResource BoolToVisConverter}}"/>
                                                            <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}"
                                                                       FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Items List -->
                                                    <Expander Header="Items to Move" IsExpanded="True" Margin="0,10,0,0">
                                                        <DataGrid ItemsSource="{Binding Items}"
                                                                  AutoGenerateColumns="False"
                                                                  IsReadOnly="True"
                                                                  MaxHeight="300"
                                                                  GridLinesVisibility="Horizontal"
                                                                  AlternatingRowBackground="#F5F5F5">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*"/>
                                                                <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="80"/>
                                                                <DataGridTextColumn Header="Last Modified"
                                                                                    Binding="{Binding LastModified, StringFormat='yyyy-MM-dd hh:mm:ss tt'}"
                                                                                    Width="170"/>
                                                                <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes}" Width="80">
                                                                    <DataGridTextColumn.ElementStyle>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                                        </Style>
                                                                    </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>
                                                                <!-- DisplayMovedToPath covers both real moves (MovedToPath)
                                                                     and DryRun simulations (WouldMovedToPath). -->
                                                                <DataGridTextColumn Header="Destination" Binding="{Binding DisplayMovedToPath}" Width="2*"/>
                                                                <!-- Action column shows "Moved", "Would Move", "Error", or "Identified"
                                                                     via CleanupItem.MoveActionLabel. -->
                                                                <DataGridTextColumn Header="Action"
                                                                                    Binding="{Binding MoveActionLabel}"
                                                                                    Width="100"/>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                    </Expander>

                                                    <!-- Errors (if any) -->
                                                    <StackPanel Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisConverter}}"
                                                                Margin="0,10,0,0">
                                                        <TextBlock Text="Errors:" FontWeight="Bold" Foreground="Red"/>
                                                        <ItemsControl ItemsSource="{Binding Errors}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Margin="10,2,0,0">
                                                                        <Run Text="&#x2022; " Foreground="Red"/>
                                                                        <Run Text="{Binding Path, Mode=OneWay}"/>
                                                                        <Run Text=": "/>
                                                                        <Run Text="{Binding Message, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>





        </TabControl>


        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Height="30">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}" Margin="5,0"/>

                    <ProgressBar Width="200" 
                                 Height="16" 
                                 Margin="10,0"
                                 Value="{Binding ProgressPercentage}"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisConverter}}"/>

                    <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0}%'}" 
                               Margin="5,0"
                               Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisConverter}}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

